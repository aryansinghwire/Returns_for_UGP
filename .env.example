# Copy this file to .env and fill it in. run_dev.sh loads .env automatically
# if it exists. Git ignores .env, but not this example file.

# The secret key that signs login tokens. Without it, the server uses a fixed
# development key that anyone can read in the code - fine on your own
# computer, never for anything real.
RETURNS_DASHBOARD_JWT_SECRET=

# Set to 1 only when the site is served over HTTPS. Over plain
# http://localhost the browser silently ignores a "Secure" cookie, so login
# seems to work but every request after it is refused (401).
RETURNS_DASHBOARD_COOKIE_SECURE=0
